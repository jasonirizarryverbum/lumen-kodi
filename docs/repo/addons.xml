<?xml version="1.0" encoding="UTF-8"?>
<addons><addon id="repository.lumen" name="Lumen Repository" version="1.0.2" provider-name="Lumen">
	<extension point="xbmc.addon.repository" name="Lumen Repository">
		<dir>
			<info compressed="false">https://jasonirizarryverbum.github.io/lumen-kodi/repo/addons.xml</info>
			<checksum>https://jasonirizarryverbum.github.io/lumen-kodi/repo/addons.xml.md5</checksum>
			<datadir zip="true">https://jasonirizarryverbum.github.io/lumen-kodi/repo/zips/</datadir>
		</dir>
		
		<dir minversion="20.9.1">
			<info compressed="false">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml</info>
			<checksum>https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/addons.xml.md5</checksum>
			<datadir zip="true">https://raw.githubusercontent.com/jurialmunkey/repository.jurialmunkey/master/omega/zips/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/jasonirizarryverbum/lumen-kodi</source>
		<assets>
			<icon>icon.png</icon>
		</assets>
		<summary lang="en_GB">Updates for the Lumen skin and setup tool.</summary>
		<description lang="en_GB">Hosts the Lumen skin and the Lumen Setup tool, and passes through TMDb Helper's own repository for its current version. It contains no streaming add-ons.</description>
	</extension>
</addon><addon id="script.lumen.setup" name="Lumen Setup" version="0.9.7" provider-name="Lumen">
	<requires>
		<import addon="xbmc.python" version="3.0.1" />
		<import addon="plugin.video.themoviedb.helper" version="6.20.5" />
		<import addon="script.module.tmdbhelper.sync.trakt" version="1.2.0" />
	</requires>
	<extension point="xbmc.python.script" library="default.py">
		<provides>executable</provides>
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/jasonirizarryverbum/lumen-kodi</source>
		<assets>
			<icon>icon.png</icon>
		</assets>
		<summary lang="en_GB">One-stop setup for the Lumen build.</summary>
		<description lang="en_GB">Applies a performance profile for low-memory devices, connects Trakt through TMDb Helper, picks the default player and adds a NAS share.</description>
	</extension>
</addon><addon id="skin.lumen" version="0.9.7" name="Lumen" provider-name="Lumen (based on Estuary by phil65, Ichabod Fletchman)">
	<requires>
		<import addon="xbmc.gui" version="5.17.0" />
		<import addon="script.lumen.setup" version="0.9.7" />
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
		<source>https://github.com/jasonirizarryverbum/lumen-kodi</source>
		<assets>
			<icon>resources/icon.png</icon>
		</assets>
		<summary lang="en_GB">Lumen: a dark, lightweight, streaming-first skin.</summary>
		<description lang="en_GB">Lumen is a lean fork of Estuary (by phil65 and Team Kodi) with a dark palette and a home screen driven by Trakt and TMDb rows, plus local library rows for NAS content. Built for low-memory Google TV devices.</description>
	</extension>
</addon></addons>
